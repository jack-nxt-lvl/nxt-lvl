{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/create-direct-payment-quote.js": {
      "maxDuration": 30
    },
    "api/create-card-payment-link.js": {
      "maxDuration": 30
    },
    "api/find-direct-payment.js": {
      "maxDuration": 60
    },
    "api/verify-direct-payment.js": {
      "maxDuration": 60
    },
    "api/stripe-card-webhook.js": {
      "maxDuration": 30
    },
    "api/research-application.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=86400"
        },
        {
          "key": "X-Robots-Tag",
          "value": "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        },
        {
          "key": "Link",
          "value": "<https://www.nxtlvl-research.com/>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*).css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*).svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, s-maxage=2592000, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/(.*).webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).jpeg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/coa.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/:page((?!entry(?:/|$)|entry\\.html$|api(?:/|$)|_vercel(?:/|$)|\\.well-known(?:/|$))(?:[^.]*|.*\\.(?:html?|pdf)))",
      "headers": [
        {
          "key": "Vary",
          "value": "Cookie"
        }
      ]
    },
    {
      "source": "/:page((?!entry(?:/|$)|entry\\.html$|api(?:/|$)|_vercel(?:/|$)|\\.well-known(?:/|$))(?:[^.]*|.*\\.(?:html?|pdf)))",
      "missing": [
        {
          "type": "cookie",
          "key": "__Host-nxt-entry",
          "value": "v1"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/research/semax-10mg.html",
      "destination": "/research/semax-11mg.html",
      "permanent": true
    },
    {
      "source": "/reconstitution-water.html",
      "destination": "/research/bacteriostatic-water-10ml.html",
      "permanent": true
    },
    {
      "source": "/go/display",
      "destination": "/south-florida-research.html?utm_source=local_display&utm_medium=qr&utm_campaign=south_florida",
      "permanent": false
    },
    {
      "source": "/",
      "missing": [
        {
          "type": "cookie",
          "key": "__Host-nxt-entry",
          "value": "v1"
        }
      ],
      "destination": "/entry",
      "permanent": false
    },
    {
      "source": "/:page((?!entry(?:/|$)|entry\\.html$|api(?:/|$)|_vercel(?:/|$)|\\.well-known(?:/|$))(?:[^.]*|.*\\.(?:html?|pdf)))",
      "missing": [
        {
          "type": "cookie",
          "key": "__Host-nxt-entry",
          "value": "v1"
        }
      ],
      "destination": "/entry/:page",
      "permanent": false
    }
  ],
  "buildCommand": "node scripts/build-catalog-pages.cjs",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/entry/:path*",
      "destination": "/entry.html"
    }
  ]
}
