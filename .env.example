# Server-only secrets. Configure these in Vercel; never commit real values.
CRYPTO_QUOTE_SECRET=
RESEND_API_KEY=
ORDER_EMAIL_FROM=
ORDER_NOTIFICATION_EMAIL=payment@nxtlvl-research.com

# Optional separate hosted card-payment links. These remain hidden until a live
# Stripe key, signed webhook, Upstash, and at least one delivery method exist.
# Prefer a restricted key (rk_) with only required Checkout permissions.
# Production accepts live keys only; development and previews accept test keys only.
STRIPE_SECRET_KEY=
# Subscribe to checkout.session.completed, checkout.session.async_payment_succeeded,
# and checkout.session.async_payment_failed in the matching Stripe environment.
STRIPE_WEBHOOK_SECRET=
RESEARCH_COMMERCE_ENABLED=false
STRIPE_RESEARCH_APPROVED=false
PUBLIC_SITE_URL=https://www.nxtlvl-research.com

# Optional SMS delivery for hosted links (email uses RESEND_API_KEY above).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
TWILIO_SHORTEN_URLS=false

# Optional production services.
ETHEREUM_RPC_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
